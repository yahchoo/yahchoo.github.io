{
  "name": "yahchoo-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-web.mjs && cap sync",
    "build:web": "node scripts/build-web.mjs",
    "assets": "node scripts/make-assets.mjs && capacitor-assets generate --android --ios --iconBackgroundColor \"#1b2f5b\" --splashBackgroundColor \"#1b2f5b\" --splashBackgroundColorDark \"#1b2f5b\"",
    "android": "npm run build && cap run android",
    "ios": "npm run build && cap open ios"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.2.1",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capgo/capacitor-social-login": "^8.7.5"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.6.0"
  },
  "allowScripts": {
    "sharp@0.32.6": true
  }
}
